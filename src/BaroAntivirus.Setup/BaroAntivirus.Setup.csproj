<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Baro_setup</AssemblyName>
    <ApplicationTitle>BaroAntivirus Setup</ApplicationTitle>
    <ApplicationIcon>..\..\assets\baro.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <SatelliteResourceLanguages>en;vi</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\BaroPayload.zip" LogicalName="BaroPayload.zip" Condition="Exists('..\..\dist\BaroPayload.zip')" />
  </ItemGroup>
</Project>

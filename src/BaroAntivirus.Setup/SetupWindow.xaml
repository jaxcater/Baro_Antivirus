<Window x:Class="BaroAntivirus.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt BaroAntivirus"
        Width="490" Height="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FA" Foreground="#131416"
        FontFamily="IBM Plex Sans, Segoe UI">
    <Grid Margin="10">
        <Border Background="#FFFFFF" BorderBrush="#E8EAEC" BorderThickness="1" CornerRadius="12" Padding="20,16">
            <DockPanel LastChildFill="True">
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="24" Height="24" Margin="0,0,10,0">
                            <Path Data="M12,1 L22,5 L20.5,14 C20,18.5 16,21.5 12,23 C8,21.5 4,18.5 3.5,14 L2,5 Z" Fill="#1B6C80"/>
                            <Path Data="M8,12 L10.8,14.8 L16.2,9.2" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock x:Name="TxtTitle" Text="Cài đặt BaroAntivirus" FontSize="17" FontWeight="SemiBold" Foreground="#131416"/>
                            <TextBlock x:Name="TxtSub" Text="Phiên bản 1.0 · Bảo vệ Real-time &amp; DeepScan siêu nhẹ" FontSize="11.5" Foreground="#5D5F60"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer Buttons & Progress -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <ProgressBar x:Name="ProgInstall" Height="6" Minimum="0" Maximum="100" Value="0" Background="#E8EAEC" Foreground="#1B6C80" BorderThickness="0" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="11.5" Foreground="#5D5F60" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <Grid>
                        <Button x:Name="BtnCancel" Content="Hủy" HorizontalAlignment="Left" Width="80" Height="30"
                                Background="#FFFFFF" Foreground="#131416" BorderBrush="#CDCED1" BorderThickness="1" Click="BtnCancel_Click"/>
                        <Button x:Name="BtnPrimary" Content="Cài đặt ngay" HorizontalAlignment="Right" Padding="16,0" Height="30"
                                Background="#131416" Foreground="#FFFFFF" FontWeight="Medium" BorderThickness="0" Click="BtnPrimary_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Body: Install Options -->
                <StackPanel x:Name="PanelInstallOptions" VerticalAlignment="Top">
                    <TextBlock Text="Thư mục cài đặt" FontSize="12" FontWeight="Medium" Foreground="#131416" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallDir" Grid.Column="0" Height="30" Padding="8,4" VerticalContentAlignment="Center"
                                 BorderBrush="#CDCED1" BorderThickness="1" FontSize="12" Margin="0,0,6,0"/>
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="Chọn..." Height="30" Padding="10,0"
                                Background="#FFFFFF" BorderBrush="#CDCED1" BorderThickness="1" Click="BtnBrowse_Click"/>
                    </Grid>

                    <Border BorderBrush="#E8EAEC" BorderThickness="1" CornerRadius="8" Padding="12,10" Background="#F4F6F8">
                        <StackPanel>
                            <CheckBox x:Name="ChkDesktopShortcut" Content="Tạo lối tắt ngoài màn hình Desktop" IsChecked="True" FontSize="12" Margin="0,3"/>
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="Tạo lối tắt trong Start Menu" IsChecked="True" FontSize="12" Margin="0,3"/>
                            <CheckBox x:Name="ChkAutoStartup" Content="Tự khởi chạy bảo vệ nền cùng Windows (--minimized)" IsChecked="True" FontSize="12" Margin="0,3"/>
                            <CheckBox x:Name="ChkLaunchAfter" Content="Mở BaroAntivirus ngay sau khi cài đặt xong" IsChecked="True" FontSize="12" Margin="0,3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Body: Uninstall Confirmation -->
                <StackPanel x:Name="PanelUninstallInfo" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Bạn muốn gỡ cài đặt BaroAntivirus khỏi máy tính?" FontSize="13.5" FontWeight="Medium" Foreground="#131416" Margin="0,0,0,6"/>
                    <TextBlock Text="Thao tác này sẽ dừng lá chắn thời gian thực, xóa tệp chương trình và gỡ mục khởi động cùng Windows." FontSize="12" Foreground="#5D5F60" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
